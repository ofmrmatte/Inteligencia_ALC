{
  "name": "alc-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "extensions/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=alc-painel-inteligencia --",
    "dev:inteligencia": "npm run dev --workspace=alc-painel-inteligencia --",
    "build": "npm run build --workspace=alc-painel-inteligencia --",
    "build:inteligencia": "npm run build --workspace=alc-painel-inteligencia --",
    "start": "npm run start --workspace=alc-painel-inteligencia --",
    "start:inteligencia": "npm run start --workspace=alc-painel-inteligencia --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=alc-painel-inteligencia",
    "audit:perf": "npm run audit:perf --workspace=alc-painel-inteligencia",
    "extension:build": "npm run build --workspace=alc-pnr-connector",
    "prefatura:backfill": "npm run prefatura:backfill --workspace=alc-painel-inteligencia --",
    "drivers:sync": "npm run drivers:sync --workspace=alc-painel-inteligencia --",
    "dev:atendimento": "npm run dev --workspace=@alc/atendimento --",
    "build:atendimento": "npm run build --workspace=@alc/atendimento",
    "start:atendimento": "npm run start --workspace=@alc/atendimento"
  }
}
