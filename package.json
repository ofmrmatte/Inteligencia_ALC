{
  "name": "dashboardfatura",
  "version": "1.0.0",
  "private": true,
  "description": "Painel de Inteligência Operacional.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components features lib proxy.ts next.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:rules": "tsx --test tests/pre-fatura-domain.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:rules && npm run build",
    "check:legacy": "node --check legacy/app.js && node --check legacy/authService.js && node --check legacy/config.js && node --check legacy/dashboardCacheService.js && node --check legacy/railwayApiClient.js && node --check legacy/railwayStagingClient.js && node --check legacy/supabaseClient.js && node --check scripts/cleanup-local-artifacts.mjs && node --check scripts/run-audits.mjs && node --check scripts/railway/07-serve-railway-dashboard.mjs",
    "verify:runtime": "node scripts/verify-production-runtime.mjs",
    "cleanup:local": "node scripts/cleanup-local-artifacts.mjs",
    "audit:all": "node scripts/run-audits.mjs",
    "audit:dashboard": "node scripts/audit-dashboard-health.mjs",
    "audit:supabase": "node scripts/audit-supabase-health.mjs",
    "audit:dead-code": "node scripts/find-dead-code.mjs",
    "audit:module-isolation": "node scripts/check-module-isolation.mjs",
    "audit:dedupe": "node scripts/check-dedupe-integrity.mjs",
    "audit:row-counts": "node scripts/check-row-count-reconciliation.mjs",
    "audit:raw-data": "node scripts/audit-raw-data-compaction.mjs",
    "audit:railway": "node scripts/check-railway-sizing.mjs",
    "railway:check": "node scripts/railway/01-check-railway-connection.mjs",
    "railway:schema": "node scripts/railway/02-apply-schema.mjs",
    "railway:export": "node scripts/railway/03-export-supabase-clean.mjs",
    "railway:import": "node scripts/railway/04-import-railway.mjs",
    "railway:compare": "node scripts/railway/05-compare-supabase-railway.mjs",
    "railway:validate": "node scripts/railway/06-validate-railway-dashboard.mjs",
    "railway:serve-dashboard": "node scripts/railway/07-serve-railway-dashboard.mjs",
    "hybrid:serve": "node scripts/railway/07-serve-railway-dashboard.mjs",
    "railway:dry-run": "npm run railway:schema -- --dry-run && npm run railway:export -- --dry-run && npm run railway:import -- --dry-run && npm run railway:compare -- --dry-run && npm run railway:validate -- --dry-run",
    "db:migrate:processed-records": "node scripts/apply-processed-records-migration.mjs",
    "db:migrate:missing-packages": "node scripts/apply-missing-packages-migration.mjs",
    "fix:stuck-pnr-processing": "node scripts/fix-stuck-processing-files.mjs",
    "start:legacy-api": "node scripts/railway/07-serve-railway-dashboard.mjs",
    "start:api": "node scripts/railway/07-serve-railway-dashboard.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.87.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofmrmatte/dashboardfatura.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ofmrmatte/dashboardfatura/issues"
  },
  "homepage": "https://github.com/ofmrmatte/dashboardfatura#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3"
  }
