{
  "manifest_version": 3,
  "name": "ALC PNR Connector",
  "version": "1.1.17",
  "description": "Conecta a Bandeja PNR autenticada do Mercado Livre ao Inteligência ALC.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://envios.adminml.com/*",
    "https://inteligenciaalc-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://inteligenciaalc-production.up.railway.app/*"
      ],
      "js": [
        "panel-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
